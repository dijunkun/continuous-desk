    in-out property <string> local-desktop: "Local Desktop";
    in-out property <string> remote-desktop: "Remote Desktop";
    in-out property <string> recent-connections: "Recent Connections";
    in-out property <string> local-id: "Local ID";
    in-out property <string> device-name: "Device Name";
    in-out property <string> remote-id: "Remote ID";
    in-out property <string> online: "Online";
    in-out property <string> offline: "Offline";
