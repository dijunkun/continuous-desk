    in-out property <string> adaptation-policy: "Video preference";
    in-out property <string> priority-frame-rate: "Frame rate";
    in-out property <string> priority-quality: "Quality";
    in-out property <string> priority-balanced: "Balanced";
    in-out property <string> codec: "Video codec";
    in-out property <string> hardware-codec: "Hardware video codec";
    in-out property <string> turn-relay: "TURN relay";
